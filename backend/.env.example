ENV=production
DEBUG=false
# For Docker Compose, use hostnames 'db' and 'redis':
# DATABASE_URL=postgresql+asyncpg://cognitio:cognitio_secure_pw@db:5432/cognitio_erp
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
DATABASE_URL=postgresql+asyncpg://cognitio:cognitio@localhost:5432/cognitio_erp
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET_KEY=change-me-to-a-real-64-char-random-secret-before-any-real-deploy

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 / S3-compatible storage
STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=# R2 API token access key ID
STORAGE_SECRET_KEY=# R2 API token secret access key
STORAGE_BUCKET=cognitio-erp-files

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

RESEND_API_KEY=
TERMII_API_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

SENTRY_DSN=
ALLOWED_ORIGINS=["http://localhost:3000"]
